:root{
  --hero-bg: url('https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiqRdLM6uDCXu0ZUszQiCX_gCOMIWRa4GqNwC2Kb3hsDG5rB5HfaUZZa7sgZTgEZ4MnttGzXFLd-dt1OrI3SwdL7XDdosfUFEXq9L7tN_6PGwBaEH6jmPnloWJSiQ_6HeHSOnA9owASTnsWYUK3CPqS5d-Gd9NHYBPfW2vjEI2CUc4_CAf72b07j7N3YMY/s1600/MinerModss.webp');
  --accent: #388E3C;
  --accent-dark: #2E7D32;
  --accent-light: #4CAF50;
}

.container{width:100%;max-width:1200px;margin:0 auto;padding:0 1rem}

.header{
  background:#111118;
  border-bottom:1px solid #1e1e2e;
  position:sticky;
  top:0;
  z-index:1000;
  transition:background .3s,box-shadow .3s,backdrop-filter .3s;
}
.header.scrolled{
  background:rgba(13,13,20,0.8);
  -webkit-backdrop-filter:blur(12px);
  backdrop-filter:blur(12px);
  box-shadow:0 4px 20px rgba(0,0,0,.4);
  border-bottom-color:transparent;
}
.header__inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:.6rem 0;
  gap:.3rem;
  line-height:1;
}

.header .widget,
#header-logo .widget,
#header-menu .widget,
#footer-links .widget,
.footer .widget {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

.logo{
  display:flex;
  align-items:center;
  gap:.5rem;
  z-index:1001;
  line-height:1;
}
.logo__img{width:28px;height:28px;border-radius:7px;object-fit:cover}
.logo__text{
  font-size:1.15rem;
  font-weight:700;
  color: var(--accent);
  letter-spacing:-.5px;
  white-space:nowrap;
  line-height:1;
  font-family:'Playfair Display', 'Georgia', serif;
}
.logo::before{
  content: "\f17b";
  font-family: "Font Awesome 5 Brands";
  font-weight: 400;
  font-size: 1.2rem;
  color: var(--accent);
  margin-right: .3rem;
}
.logo.has-image::before{display:none}

#nav-check, #search-check { display: none; }

.nav__toggle{display:none}
.nav__menu{display:flex;align-items:center;gap:.15rem}
.nav__menu a{
  display:block;
  padding:.35rem .8rem;
  color:#b0bec5;
  font-weight:600;
  font-size:.82rem;
  border-radius:20px;
  transition:padding .3s cubic-bezier(.4,0,.2,1),background .3s cubic-bezier(.4,0,.2,1),color .3s;
  white-space:nowrap;
  line-height:1;
  text-decoration:none;
  position:relative;
  background:transparent;
  font-family:'Roboto', sans-serif;
}
.nav__menu a:hover,
.nav__menu a.active{
  color:#fff;
  background:rgba(56,142,60,.35);
  padding-left:1.1rem;
  padding-right:1.1rem;
  text-decoration:none;
}

.nav__menu .dropdown > a::after {
  content: "\f107";
  font-family: "Font Awesome 5 Free";
  font-weight: 900;
  font-size: .65rem;
  margin-left: .35rem;
  display: inline-block;
  transition: transform .3s;
}
.nav__menu .dropdown:hover > a::after {
  transform: rotate(180deg);
}
.nav__menu .dropdown{position:relative}
.nav__menu .dropdown__menu{
  display:none;
  position:absolute;
  top:100%;left:0;
  background:#1a1a25;
  border:1px solid #2a2a3a;
  border-radius:8px;
  min-width:160px;
  padding:.4rem;
  box-shadow:0 10px 25px rgba(0,0,0,.5);
  z-index:999;
}
.nav__menu .dropdown:hover .dropdown__menu{display:block}
.nav__menu .dropdown__menu a{
  padding:.4rem .7rem;
  font-size:.75rem;
  text-decoration:none;
  border-radius:6px;
}
.nav__menu .dropdown__menu a:hover{
  background:rgba(56,142,60,.3);
  padding-left:.9rem;
  padding-right:.9rem;
}

.header__search{display:flex;align-items:center;gap:.3rem}
.header__search input{
  background:#1e1e2e;
  border:1px solid #2a2a3a;
  color:#e2e8f0;
  padding:0 .5rem;
  border-radius:20px;
  font-size:.8rem;
  width:160px;
  height:30px;
  line-height:30px;
}
.header__search input:focus{border-color:var(--accent);width:180px}
.header__search button{
  background:var(--accent);
  color:#fff;
  width:28px;height:28px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:.9rem;
  transition:background .2s;
}
.header__search button:hover{background:var(--accent-dark)}

.search-btn{display:none}

.nav-search{
  position:fixed;
  top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,.9);
  z-index:9999;
  display:none;
  align-items:center;
  justify-content:center;
}
#search-check:checked ~ .nav-search { display: flex; }
.nav-search form{width:90%;max-width:400px;display:flex;gap:0}
.nav-search input{
  flex:1;
  padding:.7rem 1rem;
  background:#1e1e2e;
  border:2px solid #2a2a3a;
  border-right:none;
  color:#fff;
  font-size:1rem;
  border-radius:30px 0 0 30px;
}
.nav-search input:focus{border-color:var(--accent)}
.nav-search button{
  padding:.7rem 1.2rem;
  background:var(--accent);
  color:#fff;
  font-weight:700;
  border-radius:0 30px 30px 0;
  font-size:1rem;
}

.hero{
  background-image: var(--hero-bg);
  background-repeat: repeat-x;
  background-size: auto 100%;
  background-position: 0 0;
  animation: heroSlide 60s linear infinite;
  position:relative;
  padding:2.5rem 1rem;
  text-align:center;
  overflow:hidden;
}
.hero::before{
  content:'';
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.65);
  z-index:1;
}
@keyframes heroSlide{
  from{background-position:0 0}
  to{background-position:-1000px 0}
}
.hero__content{
  position:relative;
  z-index:2;
  max-width:650px;
  margin:0 auto;
}
.hero__title{
  font-size:2rem;
  margin-bottom:.5rem;
  color:#fff;
  text-shadow:0 4px 15px rgba(0,0,0,.8);
  font-weight:700;
  font-family:'Playfair Display', 'Georgia', serif;
}
.hero__subtitle{
  font-size:1rem;
  color:#e0e0e0;
  margin-bottom:1.5rem;
  text-shadow:0 2px 5px rgba(0,0,0,.6);
}
.hero__search{
  display:flex;
  max-width:450px;
  margin:0 auto;
}
.hero__search input{
  flex:1;
  padding:.7rem 1.2rem;
  background:rgba(0,0,0,.6);
  border:2px solid rgba(255,255,255,.3);
  border-right:none;
  color:#fff;
  font-size:.95rem;
  border-radius:30px 0 0 30px;
}
.hero__search input:focus{border-color:var(--accent)}
.hero__search button{
  padding:.7rem 1.4rem;
  background:var(--accent);
  color:#fff;
  font-weight:700;
  border-radius:0 30px 30px 0;
  font-size:.95rem;
  transition:background .2s;
}
.hero__search button:hover{background:var(--accent-dark)}

.main{
  display:flex;
  gap:1.8rem;
  padding:1.8rem 0 0.8rem;
  align-items:flex-start;
}
.main__blog{
  width:calc(100% - 300px - 1.8rem);
  min-width:0;
}
.sidebar{width:300px;flex-shrink:0}

@media (max-width:900px){.main{flex-direction:column}.main__blog{width:100%}.sidebar{width:100%}}

@media (max-width:768px){
  html{font-size:15px}
  .header__inner{padding:.45rem 0.8rem}
  .nav__menu a{padding:.4rem .7rem;font-size:.8rem}
  .hero{padding:2rem .8rem}
  .hero__title{font-size:1.6rem}.hero__subtitle{font-size:.9rem}
  .hero__search{max-width:100%;padding:0 .5rem}
  .hero__search input,.hero__search button{font-size:.9rem;padding:.6rem 1rem}
  .container{padding:0 0.8rem}
  .main{padding:1.5rem 0 0.5rem}

  .header__search{display:none!important}
  #header-menu{position:absolute;top:100%;left:0;right:0;z-index:1000}
  #header-menu .widget{margin:0;padding:0;background:transparent;border:none}
  .nav__menu{
    display:none;flex-direction:column;background:rgba(17,17,24,0.95);
    -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
    border-bottom:2px solid #1e1e2e;padding:.8rem;gap:.4rem;
    box-shadow:0 12px 28px rgba(0,0,0,.7);position:relative;
  }
  #nav-check:checked ~ header .nav__menu{display:flex}
  .nav__menu a{font-size:1rem;padding:.7rem 1rem;font-weight:500;white-space:normal;line-height:1.3;border-radius:8px}
  .nav__menu .dropdown__menu{position:static;background:transparent;border:none;padding-left:1.2rem;box-shadow:none;display:none}
  .nav__menu .dropdown.open .dropdown__menu{display:block}
  .nav__toggle{display:flex;flex-direction:column;gap:4px;padding:10px;grid-column:1;justify-self:start;margin:0;cursor:pointer}
  .nav__toggle span{width:22px;height:2px;background:#b0bec5;border-radius:2px;transition:all .3s}
  #nav-check:checked ~ header .nav__toggle span:nth-child(1){transform:rotate(45deg) translate(4px,5px)}
  #nav-check:checked ~ header .nav__toggle span:nth-child(2){opacity:0}
  #nav-check:checked ~ header .nav__toggle span:nth-child(3){transform:rotate(-45deg) translate(4px,-5px)}
  .search-btn{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;color:#b0bec5;font-size:1.2rem;grid-column:3;justify-self:end;margin:0;cursor:pointer}
  .logo{grid-column:2;justify-self:center;margin:0}
  .logo__text{font-size:1.1rem}
}

@media (max-width:480px){
  html{font-size:14px}
  .container{padding:0}
  .header__inner{padding:.35rem 0.6rem}
  .logo__text{font-size:1rem}
  .hero{padding:1.5rem .4rem}
  .hero__title{font-size:1.4rem}.hero__subtitle{font-size:.85rem}
  .hero__search{flex-direction:row;padding:0 .8rem}
  .hero__search input{font-size:.85rem;padding:.5rem .8rem}
  .hero__search button{font-size:.85rem;padding:.5rem 1rem}
  .main{padding:.8rem 0 .4rem}
  .sidebar{margin-top:.8rem}
}

body{background:$(bg.color);color:$(text.color)}
a{color:$(accent.color)}
