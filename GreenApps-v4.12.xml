<b:if cond='data:view.isHomepage'>
<div class='hero'>
  <div class='container hero__content'>
    <h2 class='hero__title'>Bienvenido a <data:blog.title/></h2>
    <p class='hero__subtitle'>Descubre las mejores aplicaciones, juegos, ROMs y texturas para tu dispositivo</p>
    <form action='/search' class='hero__search' method='get'>
      <input type='text' name='q' placeholder='Que estas buscando?' required='required' autocomplete='off'/>
      <button type='submit'><i class='fas fa-search'></i> Buscar</button>
    </form>
  </div>
</div>
</b:if>

<div class='container main' id='main-content' role='main'>
  <div class='main__blog'>
    <b:section id='BlogSection' showaddelement='no'>
      <b:widget id='Blog1' locked='false' title='Entradas del blog' type='Blog' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='showDateHeader'>false</b:widget-setting>
          <b:widget-setting name='commentLabel'>Comentarios</b:widget-setting>
          <b:widget-setting name='showShareButtons'>true</b:widget-setting>
          <b:widget-setting name='showCommentLink'>true</b:widget-setting>
          <b:widget-setting name='showAuthor'>false</b:widget-setting>
          <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
          <b:widget-setting name='showLabels'>true</b:widget-setting>
          <b:widget-setting name='showLocation'>false</b:widget-setting>
          <b:widget-setting name='showTimestamp'>true</b:widget-setting>
          <b:widget-setting name='showBacklinks'>false</b:widget-setting>
          <b:widget-setting name='showReactions'>false</b:widget-setting>
        </b:widget-settings>

        <b:includable id='main'>
          <b:if cond='data:view.isError'>
            <div class='article text-center'><h2><data:messages.theresNothingHere/></h2></div>
          <b:elseif cond='data:view.isMultipleItems'/>
            <b:if cond='data:view.search.query'>
              <div class='widget' style='margin-bottom:1.5rem'>
                <div class='widget__title'><i class='fas fa-search'></i> Resultados para: <strong style='color:var(--accent)'><data:view.search.query.escaped/></strong></div>
              </div>
            </b:if>
            <b:if cond='data:posts.empty'>
              <div class='article text-center'><p>No se encontraron entradas.</p></div>
            <b:else/>
              <div class='posts-grid'>
                <b:loop values='data:posts' var='post'>
                  <article class='post-card'>
                    <b:if cond='data:post.featuredImage'>
                      <a class='post-card__img' expr:href='data:post.url' aria-label='Leer mas sobre data:post.title'>
                        <img expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage,400,&quot;1:1&quot;)' loading='lazy' width='400' height='400'/>
                        <span class='img-overlay'><i class='fas fa-search'></i></span>
                      </a>
                    <b:else/>
                      <a class='post-card__img' expr:href='data:post.url' style='background:#1a1a25'>
                        <span style='position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:2rem;color:#9e9e9e'><i class='fas fa-image'></i></span>
                      </a>
                    </b:if>
                    <div class='post-card__body'>
                      <b:if cond='data:post.labels'>
                        <div class='post-card__tags'>
                          <b:loop index='i' values='data:post.labels' var='label'>
                            <b:if cond='data:i lt 3'>
                              <a expr:href='data:label.url'><data:label.name/></a>
                            </b:if>
                          </b:loop>
                        </div>
                      </b:if>
                      <h3 class='post-card__title'><a expr:href='data:post.url'><data:post.title/></a></h3>
                      <div class='post-card__meta'>
                        <span><i class='far fa-clock'></i> <data:post.date/></span>
                        <b:if cond='data:post.allowComments'>
                          <span><i class='far fa-comment'></i> <data:post.numberOfComments/></span>
                        </b:if>
                      </div>
                      <b:if cond='data:post.snippets'>
                        <p class='post-card__snippet'><data:post.snippets.short/></p>
                      </b:if>
                    </div>
                  </article>
                </b:loop>
              </div>
            </b:if>
            <b:if cond='data:newerPageUrl or data:olderPageUrl'>
              <div class='pagination'>
                <b:if cond='data:newerPageUrl'>
                  <a expr:href='data:newerPageUrl' aria-label='Entradas mas recientes'><i class='fas fa-arrow-left'></i> Mas recientes</a>
                </b:if>
                <b:if cond='data:olderPageUrl'>
                  <a expr:href='data:olderPageUrl' aria-label='Entradas mas antiguas'>Mas antiguos <i class='fas fa-arrow-right'></i></a>
                </b:if>
              </div>
            </b:if>
          <b:else/>
            <b:loop values='data:posts' var='post'>
              <article class='article'>
                <b:if cond='data:post.labels'>
                  <div class='post-card__tags' style='margin-bottom:1rem'>
                    <b:loop values='data:post.labels' var='label'><a expr:href='data:label.url'><data:label.name/></a></b:loop>
                  </div>
                </b:if>
                <h1 class='article__title'><data:post.title/></h1>
                <div class='article__meta'>
                  <span><i class='far fa-clock'></i> <data:post.date/></span>
                  <b:if cond='data:post.allowComments'><span><i class='far fa-comment'></i> <data:post.numberOfComments/> comentarios</span></b:if>
                </div>
                <div class='article__body'><data:post.body/></div>
                <b:if cond='data:post.shareUrl'>
                  <div class='share-buttons'>
                    <a expr:href='&quot;https://www.facebook.com/sharer.php?u=&quot; + data:post.url.canonical' rel='nofollow' target='_blank' aria-label='Compartir en Facebook'><i class='fab fa-facebook-f'></i> Facebook</a>
                    <a expr:href='&quot;https://api.whatsapp.com/send?text=&quot; + data:post.url.canonical' rel='nofollow' target='_blank' aria-label='Compartir en WhatsApp'><i class='fab fa-whatsapp'></i> WhatsApp</a>
                    <a expr:href='&quot;https://t.me/share/url?url=&quot; + data:post.url.canonical + &quot;&amp;text=&quot; + data:post.title' rel='nofollow' target='_blank' aria-label='Compartir en Telegram'><i class='fab fa-telegram-plane'></i> Telegram</a>
                  </div>
                </b:if>
              </article>
              <b:if cond='data:post.allowComments'>
                <div class='post-comments'>
                  <div class='widget-title'><span class='widget-name'><i class='far fa-comments'></i> <b:message name='messages.numberOfComments'><b:param expr:value='data:post.numberOfComments' name='numComments'/></b:message></span></div>
                  <div class='comments' id='comments'>
                    <b:with value='data:post.comments' var='comments'>
                      <b:if cond='data:comments.any'>
                        <div class='comments-content'>
                          <b:loop values='data:comments where (c =&gt; not c.inReplyTo)' var='comment'>
                            <div class='comment' expr:id='&quot;c&quot; + data:comment.id'>
                              <div class='comment-avatar'>
                                <b:with value='data:comment.authorAvatarSrc contains &quot;/img/bl&quot; ? &quot;https://lh3.googleusercontent.com/a/default-user&quot; : data:comment.authorAvatarSrc' var='avatarSrc'>
                                  <img expr:alt='data:comment.author' expr:src='resizeImage(data:avatarSrc, 50, &quot;1:1&quot;)' loading='lazy'/>
                                </b:with>
                              </div>
                              <div class='comment-block'>
                                <div class='comment-header'>
                                  <span class='comment-author'><data:comment.author/></span>
                                  <span class='comment-time'><data:comment.timestamp/></span>
                                  <b:if cond='data:comment.adminClass'><span class='comment-badge' style='color:var(--accent);font-size:.75rem;'>Autor</span></b:if>
                                </div>
                                <div class='comment-content'><data:comment.body/></div>
                                <b:if cond='data:post.allowNewComments'>
                                  <div class='comment-footer'>
                                    <button class='comment-reply-button' expr:data-comment-id='data:comment.id' expr:data-comment-author='data:comment.author' onclick='replyToComment(this)'><i class='fas fa-reply'></i> Responder</button>
                                    <b:with value='data:comments where (c =&gt; c.inReplyTo == data:comment.id)' var='replies'>
                                      <b:if cond='data:replies.any'>
                                        <label class='comment-replies-label' expr:for='&quot;r&quot; + data:comment.id'><i class='far fa-comment-dots'></i> <data:replies.length/> Respuestas</label>
                                      </b:if>
                                    </b:with>
                                  </div>
                                </b:if>
                                <b:with value='data:comments where (c =&gt; c.inReplyTo == data:comment.id)' var='replies'>
                                  <b:if cond='data:replies.any'>
                                    <input class='comment-toggle' expr:id='&quot;r&quot; + data:comment.id' type='checkbox'/>
                                    <div class='comments-replies'>
                                      <b:loop values='data:replies' var='reply'>
                                        <div class='comment' expr:id='&quot;c&quot; + data:reply.id'>
                                          <div class='comment-avatar'>
                                            <b:with value='data:reply.authorAvatarSrc contains &quot;/img/bl&quot; ? &quot;https://lh3.googleusercontent.com/a/default-user&quot; : data:reply.authorAvatarSrc' var='replyAvatarSrc'>
                                              <img expr:alt='data:reply.author' expr:src='resizeImage(data:replyAvatarSrc, 40, &quot;1:1&quot;)' loading='lazy'/>
                                            </b:with>
                                          </div>
                                          <div class='comment-block'>
                                            <div class='comment-header'>
                                              <span class='comment-author'><data:reply.author/></span>
                                              <span class='comment-time'><data:reply.timestamp/></span>
                                            </div>
                                            <div class='comment-content'><data:reply.body/></div>
                                          </div>
                                        </div>
                                      </b:loop>
                                    </div>
                                  </b:if>
                                </b:with>
                              </div>
                            </div>
                          </b:loop>
                        </div>
                      </b:if>
                    </b:with>
                    <b:if cond='data:post.allowNewComments'>
                      <div class='comment-form'>
                        <div class='reply-notice' id='reply-notice'>
                          <i class='fas fa-reply'></i> <span id='reply-author-name'></span>
                          <button class='cancel-reply-btn' onclick='cancelReply()'><i class='fas fa-times'></i> Cancelar</button>
                        </div>
                        <b:include data='post' name='commentPicker'/>
                      </div>
                    </b:if>
                  </div>
                </div>
                <b:include data='post' name='threadedCommentJs'/>
              </b:if>
            </b:loop>
          </b:if>
        </b:includable>

        <b:includable id='commentPicker' var='post'>
          <b:if cond='data:post.allowNewComments'>
            <a expr:href='data:post.commentFormIframeSrc params {skin: &quot;emporio&quot;}' id='comment-editor-src'/>
            <iframe class='blogger-iframe-colorize blogger-comment-from-post' id='comment-editor' src='' loading='lazy'/>
            <data:post.cmtfpIframe/>
            <script>BLOG_CMT_createIframe(&quot;<data:post.appRpcRelayPath/>&quot;);</script>
          </b:if>
        </b:includable>

        <b:includable id='threadedCommentJs' var='post'>
          <script async='async' expr:src='data:post.commentSrc'/>
          <b:template-script inline='true' name='threaded_comments'/>
          <script>//<![CDATA[
            var a = document.getElementsByClassName("avatar-image-container");
            for (i = 0; i < a.length; i++) a[i].childNodes[0].setAttribute("src", a[i].childNodes[0].getAttribute("src").replace(/s\B\d{2,4}/, "s80"));
          //]]></script>
        </b:includable>
      </b:widget>
    </b:section>
  </div>

  <aside class='sidebar'>
    <b:section id='sidebar-section'>
      <b:widget id='PopularPosts1' locked='false' title='Lo mas popular' type='PopularPosts' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='numItemsToShow'>4</b:widget-setting>
          <b:widget-setting name='showThumbnails'>true</b:widget-setting>
          <b:widget-setting name='showSnippets'>false</b:widget-setting>
          <b:widget-setting name='timeRange'>ALL_TIME</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <div class='widget'>
            <div class='widget__title'><i class='fas fa-fire'></i> Lo mas popular</div>
            <div class='widget-content'>
              <b:if cond='data:posts.empty'><p>No hay entradas populares aun.</p>
              <b:else/>
                <b:loop values='data:posts' var='post'>
                  <a class='popular-post-link' expr:href='data:post.url' expr:aria-label='data:post.title'>
                    <b:if cond='data:post.featuredImage'>
                      <img class='popular-post__img' expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage,80,&quot;1:1&quot;)' loading='lazy' width='80' height='80'/>
                    </b:if>
                    <div>
                      <div class='popular-post__title'><data:post.title/></div>
                      <div class='popular-post__date'><data:post.date/></div>
                    </div>
                  </a>
                </b:loop>
              </b:if>
            </div>
          </div>
        </b:includable>
      </b:widget>
      <b:widget id='Label1' locked='false' title='Categorias' type='Label' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='sorting'>ALPHA</b:widget-setting>
          <b:widget-setting name='display'>CLOUD</b:widget-setting>
          <b:widget-setting name='selectedLabelsList'/>
          <b:widget-setting name='showType'>ALL</b:widget-setting>
          <b:widget-setting name='showFreqNumbers'>false</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <div class='widget'>
            <div class='widget__title'><i class='fas fa-tags'></i> Categorias</div>
            <div class='widget-content tag-cloud'>
              <b:loop values='data:labels' var='label'><a expr:href='data:label.url'><data:label.name/></a></b:loop>
            </div>
          </div>
        </b:includable>
      </b:widget>
    </b:section>
  </aside>
</div>

<footer class='footer'>
  <div class='container'>
    <div class='footer__top'>
      <b:section id='footer-links' maxwidgets='1'>
        <b:widget id='LinkList2' locked='false' title='Enlaces legales' type='LinkList' version='2' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='sorting'>NONE</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <div class='footer__links'>
